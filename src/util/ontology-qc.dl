// ===========================================================================
// GO ontology QC.
//
// Run from src/ontology:  souffle ../util/ontology-qc.dl
// Fails the build when datalog-violations.tsv is non-empty.
//
//   qc/rdf.dl          N-Triples punctuation lives here and nowhere else
//   qc/vocabulary.dl   the ontology as an editor talks about it
//   qc/registry.dl     the check registry and the error projection
//   qc/program.dl      the include list, shared with the self-test
//   qc/checks/*.dl     one file per topic; each check is registered and named
//
// To add a check: pick the topic file, write a `check(...)` fact and one or
// more `violation(...)` rules against the vocabulary, then plant a violating
// fact in qc/control.facts so `make qc-selftest` proves it fires. A check
// with no control fact is reported as silent and fails that target.
// ===========================================================================

.decl ontrdf(s:symbol, p:symbol, o:symbol)
.input ontrdf(filename="go-edit.facts")

#include "qc/program.dl"

.output error(filename="datalog-violations.tsv")

// A violation raised under an unregistered name is a typo, not a finding; it
// would otherwise be reported with a check name that matches nothing.
.output unregistered_check(filename="unregistered-checks.tsv")
