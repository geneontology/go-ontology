        <oboInOwl:hasDbXref>UMLS:C0228333</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ventral_nuclear_group</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005576</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:333</oboInOwl:hasDbXref>
