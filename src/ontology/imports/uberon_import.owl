        <oboInOwl:hasDbXref>ZFA:0005386</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0005744</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>bone foramen</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/8/81/Gray193.png</foaf:depiction>
    </owl:Class>
