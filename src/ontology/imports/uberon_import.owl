        <oboInOwl:hasRelatedSynonym>intestinal villus layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>small intestine villus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>villi intestinales</oboInOwl:hasRelatedSynonym>
