    <!-- http://purl.obolibrary.org/obo/UBERON_0010369 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010368"/>
        <rdfs:subClassOf rdf:nodeID="genid37563"/>
        <obo:IAO_0000115>A unit of lung supplied by three to five terminal bronchioles and contained by fibrous septa.</obo:IAO_0000115>
        <obo:UBPROP_0000001>a pyramidal mass of lung tissue with sides that are bounded by the incomplete interlobular connective tissue septa and with a base, which is 1-2 cm in diameter, which usually faces the pleural surface of the lung; lobules that occupy a more central position in the lung are not well defined and are considered to consist of three to five pulmonary acini with proximate terminal bronchioles.</obo:UBPROP_0000001>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <oboInOwl:hasDbXref>FMA:7414</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lobulus pulmonis secondarius</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>respiratory lobule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0010369</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>secondary pulmonary lobule</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid37563">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008946"/>
    </owl:Restriction>
