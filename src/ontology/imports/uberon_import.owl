        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000002"/>
        <owl:annotatedTarget>relationship loss: subclass external integument structures (AAO:0000961)[AAO]</owl:annotatedTarget>
