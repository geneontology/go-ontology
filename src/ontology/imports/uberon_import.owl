    <!-- http://purl.obolibrary.org/obo/UBERON_0002129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019263"/>
        <rdfs:subClassOf>
