            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory receptor that detects chemical stimulus within the body.</obo:IAO_0000115>
        <obo:UBPROP_0000001>Cells specialized to detect chemical substances and relay that information centrally in the nervous system. Chemoreceptors may monitor external stimuli, as in taste and olfaction, or internal stimuli, such as the concentrations of oxygen and carbon dioxide in the blood.</obo:UBPROP_0000001>
        <oboInOwl:hasDbXref>FMA:85604</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0018391</oboInOwl:id>
        <rdfs:label>chemoreceptor</rdfs:label>
    </owl:Class>
