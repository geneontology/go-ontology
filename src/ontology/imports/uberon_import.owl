        <oboInOwl:hasDbXref>EHDAA:9148</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:18275</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:46699</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002296</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:244782006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000825</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>extrinsic lingual muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>extrinsic tongue muscle</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0001575</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>extrinsic muscle of tongue</rdfs:label>
    </owl:Class>
