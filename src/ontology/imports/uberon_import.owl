        <oboInOwl:hasDbXref>MESH:D014725</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C12820</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362464003</oboInOwl:hasDbXref>
