        <owl:annotatedTarget>metanephric duct</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0073040584</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000605</oboInOwl:hasDbXref>
    </owl:Axiom>
    


