        <oboInOwl:hasExactSynonym>hepatic lobule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lobuli hepatici</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>lobulus hepaticus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>lobules of liver</oboInOwl:hasRelatedSynonym>
