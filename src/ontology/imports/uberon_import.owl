        <oboInOwl:hasExactSynonym>ophthalmic placode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>profundus placode</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0035597</oboInOwl:id>
        <rdfs:label>profundal placode</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035597"/>
