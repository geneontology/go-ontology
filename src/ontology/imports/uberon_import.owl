        <oboInOwl:hasRelatedSynonym>musculus obliquus superior bulbi</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>obliquus oculi superior</oboInOwl:hasRelatedSynonym>
