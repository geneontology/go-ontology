    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
        <rdfs:subClassOf rdf:nodeID="genid10812"/>
