    <!-- http://purl.obolibrary.org/obo/UBERON_0001752 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010365"/>
