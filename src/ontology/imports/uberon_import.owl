        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A bone that is part of the tarsal skeleton. Examples: calcaneus, talus, centralia.</owl:annotatedTarget>
