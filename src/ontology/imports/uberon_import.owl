                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0051606"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory nerve ending that responds to a stimulus in the internal or external environment of an organism. In response to stimuli the sensory receptor initiates sensory transduction by creating graded potentials or action potentials in the same cell or in an adjacent one.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:84650</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D011984</oboInOwl:hasDbXref>
