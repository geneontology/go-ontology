        <oboInOwl:hasExactSynonym>tastebud</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>caliculus gustatorius</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>taste buds</oboInOwl:hasRelatedSynonym>
