        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>Experients in amphibia have shown that an intrinsic feature of the pharyngeal endoderm is its ability to generate taste buds and this capacity must have been acquired by the endoderm at the origin of the vertebrates.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000130</oboInOwl:external_class>
