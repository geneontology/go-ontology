        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001103"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid3773"/>
