                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000067"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0030183"/>
            </owl:Restriction>
        </rdfs:subClassOf>
