            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An bone foramen in the ethmoid bone.</obo:IAO_0000115>
        <obo:UBPROP_0000008>There are usually two Foramina ethmoidalia present on each side in the dog. Sometimes one is situated rostral to the other, but often it is dorsal. They are not homologous with the Foramen ethmoidale anterius and Foramen ethmoidale posterius of man. Therefore they are not listed separately.[NOMINA ANATOMICA VETERINARIA (2005)]</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>Wikipedia:Ethmoidal_foramina</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ethmoidal foramen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>foramina ethmoidalia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>ethmoid foramina</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ethmoidal foramina</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0018415</oboInOwl:id>
        <rdfs:comment>Taxon nodes: In humans, refers to anterior or posterior ethmoid foramina</rdfs:comment>
        <rdfs:label>ethmoid foramen</rdfs:label>
    </owl:Class>
