    <!-- http://purl.obolibrary.org/obo/UBERON_0002173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000117"/>
        <rdfs:subClassOf>
