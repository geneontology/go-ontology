                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013769"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The layer of the endometrium adjacent to the uterine lumen, comprising the luminal epithelium, the superficial portions of the uterine glands, and the surrounding vascularized stroma, and supplied by the spiral arterioles. It proliferates and differentiates across the ovarian cycle under the influence of oestrogen and progesterone, and is the site of embryo implantation and decidualization. In menstruating species it is shed at menstruation and regenerated from the basal layer in the following cycle.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/3803</obo:IAO_0000233>
        <oboInOwl:hasDbXref>FMA:86493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C32642</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>endometrial functional layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>functionalis layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum functionale endometrii</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum functionalis of endometrium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>outer layer of endometrium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0022356</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>functional layer of endometrium</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/8/87/Cells_of_the_uterus_in_different_menstrual_cycle_stages.png</foaf:depiction>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022356"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The layer of the endometrium adjacent to the uterine lumen, comprising the luminal epithelium, the superficial portions of the uterine glands, and the surrounding vascularized stroma, and supplied by the spiral arterioles. It proliferates and differentiates across the ovarian cycle under the influence of oestrogen and progesterone, and is the site of embryo implantation and decidualization. In menstruating species it is shed at menstruation and regenerated from the basal layer in the following cycle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25141152</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:26552890</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:37288662</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022356"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>stratum functionale endometrii</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003011"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022356"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>stratum functionalis of endometrium</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:86493</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0022356"/>
        <owl:annotatedProperty rdf:resource="http://xmlns.com/foaf/0.1/depiction"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/8/87/Cells_of_the_uterus_in_different_menstrual_cycle_stages.png</owl:annotatedTarget>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <oboInOwl:hasDbXref>PMID:42853913</oboInOwl:hasDbXref>
        <rdfs:comment>Figure 6 from &quot;Standardizing Cell Ontology terms for cross-study integration in the female reproductive tract&quot; (Ong et al (2026) Science Advances 12(41): eaef2358).</rdfs:comment>
