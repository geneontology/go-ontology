    <!-- http://purl.obolibrary.org/obo/UBERON_0002396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008001"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011597"/>
