        <oboInOwl:hasExactSynonym>tarsal bones set</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tarsalia</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>basipodium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mesopodium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tarsal bones</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tarsus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0009879</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>tarsal skeleton</rdfs:label>
    </owl:Class>
