    <!-- http://purl.obolibrary.org/obo/UBERON_0005620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007375"/>
