    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An epithelial sac of invaginated ectoderm formed from the otic placode that gives rise to the structures of the inner ear[MP].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0009806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Otic_vesicle</oboInOwl:hasDbXref>
