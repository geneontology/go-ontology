    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Skeletal element that is composed of bone tissue.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO_REF:0000034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PSPUB:0000170</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VSAO:0000057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://dx.plos.org/10.1371/journal.pone.0051070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://github.com/obophenotype/uberon/issues/277</oboInOwl:hasDbXref>
