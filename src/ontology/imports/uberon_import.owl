                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BSPO_0000098"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001555"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
