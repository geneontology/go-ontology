        <owl:annotatedTarget>UMLS:C0013455</owl:annotatedTarget>
        <oboInOwl:source>BIRNLEX:1695</oboInOwl:source>
        <oboInOwl:source>ncithesaurus:Middle_Ear</oboInOwl:source>
    </owl:Axiom>
