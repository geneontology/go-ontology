        <oboInOwl:hasExactSynonym>articulationes digitorum manus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>articulationes interphalangeae manus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>interphalangeal joint of hand</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>interphalangeal joint of finger</oboInOwl:hasNarrowSynonym>
