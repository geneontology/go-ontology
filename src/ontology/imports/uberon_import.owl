        <owl:annotatedTarget>UMLS:C0152279</owl:annotatedTarget>
        <oboInOwl:source>BIRNLEX:1263</oboInOwl:source>
        <oboInOwl:source>ncithesaurus:Lateral_Ventricle</oboInOwl:source>
    </owl:Axiom>
