        <obo:IAO_0000115>The nasal vestibule is the most anterior part of the nasal cavity. It&apos;s enclosed by the cartilages of nose and lined by the same epithelium of the skin. The other part of the nasal cavity, which is lined by the respiratory epithelium, is called nasal cavity proper. [WP,unvetted].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0001761</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>CALOHA:TS-0660</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:59644</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:278940000</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Nasal_vestibule</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vestibular part of nasal cavity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>vestibulum nasale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vestibulum nasi</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0000402</oboInOwl:id>
        <rdfs:label>nasal vestibule</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/7/7c/Gray994.png</foaf:depiction>
    </owl:Class>
