        <oboInOwl:hasDbXref>FMA:9577</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:16</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000029</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000298</oboInOwl:hasDbXref>
