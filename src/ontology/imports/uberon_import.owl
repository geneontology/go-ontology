        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000008"/>
        <owl:annotatedTarget>In mice, the spinal branch of this motor nerve innervates the trapezius and the sternocleidomastoid muscles. The cranial branch joins the vagus nerve and innervates the same targets as the vagus nerve</owl:annotatedTarget>
        <oboInOwl:source>GO</oboInOwl:source>
