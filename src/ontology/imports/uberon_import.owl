        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The placental layers where embryonic blood vessels are surrounded by trophoblast cells and maternal blood.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0001716</oboInOwl:hasDbXref>
    </owl:Axiom>
