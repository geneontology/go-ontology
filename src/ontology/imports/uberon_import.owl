    <!-- http://purl.obolibrary.org/obo/UBERON_0002770 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002770">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
