    <!-- http://purl.obolibrary.org/obo/UBERON_0012449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0012449">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0012451"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050982"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012451"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0050982"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory receptor that responds to mechanical pressure or distortion.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:86587</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008465</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C13821</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mechanoreceptor</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0012449</oboInOwl:id>
        <rdfs:comment>Normally there are four main types in glabrous skin: Pacinian corpuscles, Meissner&apos;s corpuscles, Merkel&apos;s discs, and Ruffini endings. There are also mechanoreceptors in hairy skin, and the hair cells in the cochlea are the most sensitive mechanoreceptors, transducing air pressure waves into nerve signals sent to the brain. In the periodontal ligament, there are some mechanoreceptors, which allow the jaw to relax when biting down on hard objects; the mesencephalic nucleus is responsible for this reflex</rdfs:comment>
        <rdfs:label>mechanoreceptor</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sensory receptor that responds to mechanical pressure or distortion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Mechanoreceptor</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0012451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0012451">
