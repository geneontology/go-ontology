    <!-- http://purl.obolibrary.org/obo/UBERON_0001813 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001813">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001810"/>
