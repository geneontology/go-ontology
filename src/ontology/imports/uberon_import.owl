        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Skeletal subdivision consisting of a set of bones linking the axial series to the hindlimb zeugopodium and offering anchoring areas for hindlimb and caudal musculature.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>VSAO:0000155</oboInOwl:hasDbXref>
