            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Kidney pyramids are the conical arrangements of tubules that constitute the renal medulla in a multi-lobed mammalian kidney; they contain the loops of Henle and the medullary collecting ducts.</obo:IAO_0000115>
        <obo:UBPROP_0000012>not the same as FMA:50609 Pyramid (which is a volume / dimensional entity)</obo:UBPROP_0000012>
        <obo:UBPROP_0000202 rdf:resource="http://purl.obolibrary.org/obo/FMA_74268"/>
        <oboInOwl:hasAlternativeId>UBERON:0002449</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>UBERON:0005098</oboInOwl:hasAlternativeId>
        <oboInOwl:hasBroadSynonym>pyramid</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BTO:0003926</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:258870</oboInOwl:hasDbXref>
