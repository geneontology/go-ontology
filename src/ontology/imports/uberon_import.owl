    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000991"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The part of the reproductive system that produces and releases eggs (ovary) or sperm (testis).[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0000413</oboInOwl:external_class>
        <oboInOwl:ontology>TAO</oboInOwl:ontology>
        <oboInOwl:source>ZFIN:curator</oboInOwl:source>
