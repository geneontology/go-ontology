    <!-- http://purl.obolibrary.org/obo/UBERON_0004099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004099">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
