    <!-- http://purl.obolibrary.org/obo/UBERON_0005483 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005483">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
