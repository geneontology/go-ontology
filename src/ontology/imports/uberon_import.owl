        <oboInOwl:hasDbXref>FMA:293873</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000418</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000418</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C34190</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1512561</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001222</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Hypoblast</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003044</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000117</oboInOwl:hasDbXref>
