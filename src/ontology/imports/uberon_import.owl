        <obo:IAO_0000115>Skeletal element that is often isolated, small, and variable in composition.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>VSAO:0000132</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ossicles</oboInOwl:hasDbXref>
