        <oboInOwl:hasDbXref>UMLS:C0175427</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001381</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Superior_olivary_complex</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:569</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nucleus olivaris superior</oboInOwl:hasExactSynonym>
