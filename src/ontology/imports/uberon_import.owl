    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001630"/>
        <obo:IAO_0000115>A structure, usually a circular muscle, that normally maintains constriction of a natural body passage or orifice and which relaxes as required by normal physiological functioning.</obo:IAO_0000115>
        <obo:UBPROP_0000012>FMA class is not a subtype of muscle</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>FMA:75004</oboInOwl:hasDbXref>
