    <!-- http://purl.obolibrary.org/obo/UBERON_0004340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005631"/>
        <rdfs:subClassOf rdf:nodeID="genid23447"/>
