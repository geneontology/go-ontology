        <oboInOwl:hasDbXref>XAO:0000063</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000150</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>archinephric duct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ductus pronephricus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pronephric ducts</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0003060</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>The pronephric duct collects the filtrate from the pronephric tubules and opens to the exterior of the pronephric kidney[GOC:mtg_kidney_jan10, PMID:15647339, XAO:0000063, ZFA:0000150]</rdfs:comment>
        <rdfs:label>pronephric duct</rdfs:label>
