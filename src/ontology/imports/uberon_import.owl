        <oboInOwl:hasDbXref>UMLS:C0003461</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBbt:0005364</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Anus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:Anus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>anal opening</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>anal orifice</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>opening of terminal part of digestive tract</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>proctodeum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001245</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>anus</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/6/65/Protovsdeuterostomes.svg</foaf:depiction>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/7/75/Anorectum.gif</foaf:depiction>
    </owl:Class>
