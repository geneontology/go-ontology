        <obo:IAO_0000115>A gland producing tears in a third eyelid in the corner of each eye.</obo:IAO_0000115>
        <obo:IAO_0000232>This gland is distinct from the other medial ocular gland, the Harderian gland, and is typified by clusters of glandular tissue within the nictitating membrane</obo:IAO_0000232>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_39107"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_10047"/>
        <oboInOwl:hasBroadSynonym>gland of nictitating membrane</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>gland of the third eyelid</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>NCIT:C77616</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>glandula palpebra tertia superficialis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>superficial gland of the nictitating membrane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>superficial gland of the third eyelid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0013230</oboInOwl:id>
        <rdfs:comment>Disease notes: Prolapse of the Nicititans Gland is also known as Cherry Eye</rdfs:comment>
        <rdfs:label>nictitans gland</rdfs:label>
    </owl:Class>
