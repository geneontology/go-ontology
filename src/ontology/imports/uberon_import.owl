    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000105"/>
        <rdfs:subClassOf>
