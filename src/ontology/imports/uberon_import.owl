    <!-- http://purl.obolibrary.org/obo/UBERON_0000934 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000934">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0005053"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BSPO_0005001"/>
