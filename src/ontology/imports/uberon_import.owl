        <oboInOwl:hasDbXref>NCIT:C32356</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:245403006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0019149</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000220</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Common_hepatic_duct</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ductus hepaticus communis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hepatic duct</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001175</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>common hepatic duct</rdfs:label>
