        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001727"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>One of a number of receptor cell nests located in the epithelium of the papillae of the tongue and in the soft palate, epiglottis, and pharynx that mediate the sense of taste. [TFD][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000130</oboInOwl:external_class>
