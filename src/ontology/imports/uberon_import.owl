            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Medullary venules are a continuation of high endothelial venules which condense repeatedly in the interfollicular cortex and peripheral deep cortical unit and then transition to medullary venules at the corticomedullary junction. The medullary venules condense and return centripetally to the hilar vein.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-2825-0621"/>
        <oboInOwl:hasExactSynonym>venule of medulla of lymph node</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:8410036</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>medullary venule of lymph node</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_8410036"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Medullary venules are a continuation of high endothelial venules which condense repeatedly in the interfollicular cortex and peripheral deep cortical unit and then transition to medullary venules at the corticomedullary junction. The medullary venules condense and return centripetally to the hilar vein.</owl:annotatedTarget>
