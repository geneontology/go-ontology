    <!-- http://purl.obolibrary.org/obo/UBERON_0001247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001247">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0008845"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002371"/>
