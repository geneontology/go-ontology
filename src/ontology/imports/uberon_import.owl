        <oboInOwl:hasDbXref>MA:0000145</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000073</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D008321</oboInOwl:hasDbXref>
