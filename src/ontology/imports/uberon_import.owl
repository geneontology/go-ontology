        <oboInOwl:hasRelatedSynonym>cavitas peritonealis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>saccus serosus peritonei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001179</oboInOwl:id>
