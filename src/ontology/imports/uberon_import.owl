        <oboInOwl:hasDbXref>XAO:0000337</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000360</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>embryonic heart tube</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endocardial heart tube</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>endocardial tube</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0004141</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#efo_slim"/>
