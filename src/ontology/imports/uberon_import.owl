    <!-- http://purl.obolibrary.org/obo/UBERON_0004021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000119"/>
