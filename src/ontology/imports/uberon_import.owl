        <oboInOwl:hasDbXref>Wikipedia:Iliac_artery</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000361</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:IliacArtery</oboInOwl:hasDbXref>
