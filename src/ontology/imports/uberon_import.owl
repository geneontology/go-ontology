            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The smallest anatomical unit of the lung, measuring 0.50 to 2.00 cm in diameter. Each lobule is composed of 4-8 terminal bronchioles and their distal alveolar ducts and sacs. The lobules are separated by fibrous interlobular septa.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:75739</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33428</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lobulus pulmonis</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0010368</oboInOwl:id>
        <rdfs:label>pulmonary lobule</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010368"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The smallest anatomical unit of the lung, measuring 0.50 to 2.00 cm in diameter. Each lobule is composed of 4-8 terminal bronchioles and their distal alveolar ducts and sacs. The lobules are separated by fibrous interlobular septa.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ncithesaurus:Pulmonary_Lobule</oboInOwl:hasDbXref>
    </owl:Axiom>
