        <oboInOwl:hasDbXref>MAT:0000278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C49477</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:322050006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0222646</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VSAO:0000076</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Appendicular_skeleton</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003166</oboInOwl:hasDbXref>
