        <oboInOwl:hasDbXref>UMLS:C0039484</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Temporal_bone</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>os temporale</oboInOwl:hasRelatedSynonym>
