        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A subdivision of the digestive tract that connects the small intestine to the cloaca or anus. Lacks or has few villi[Kardong].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0073040584</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Large_intestine_(anatomy)</oboInOwl:hasDbXref>
