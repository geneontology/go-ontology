        <rdfs:label>pleural cavity</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/a/ab/Gray965.png</foaf:depiction>
