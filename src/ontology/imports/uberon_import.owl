    <!-- http://purl.obolibrary.org/obo/UBERON_0001215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001215">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
