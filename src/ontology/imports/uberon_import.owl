        <oboInOwl:hasDbXref>VHOG:0001062</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>2nd pharyngeal arch ectoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0005660</oboInOwl:id>
        <rdfs:label>2nd arch ectoderm</rdfs:label>
    </owl:Class>
