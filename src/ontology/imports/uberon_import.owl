            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The twelve spinal nerves on each side of the thorax. They include eleven INTERCOSTAL NERVES and one subcostal nerve. Both sensory and motor, they supply the muscles and skin of the thoracic and abdominal walls.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:5860</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:857</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D013900</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:360498003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Thoracic_nerves</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1725</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>nervus thoracis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thoracic spinal nerve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>nervi thoracici</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pectoral nerve</oboInOwl:hasRelatedSynonym>
