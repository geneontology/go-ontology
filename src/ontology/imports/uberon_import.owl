    <!-- http://purl.obolibrary.org/obo/UBERON_0001255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002075"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
