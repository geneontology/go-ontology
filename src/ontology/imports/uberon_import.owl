    <!-- http://purl.obolibrary.org/obo/UBERON_0009880 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009880">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
