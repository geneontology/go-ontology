        <oboInOwl:hasDbXref>VHOG:0001476</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Lacrimal_gland</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Preorbital_gland</oboInOwl:hasDbXref>
