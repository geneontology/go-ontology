        <oboInOwl:hasDbXref>MA:0000347</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MAT:0000040</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D014059</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000040</oboInOwl:hasDbXref>
