    <!-- http://purl.obolibrary.org/obo/UBERON_0005313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003244"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005153"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034969"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001765"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A unique club-shaped epithelial structure that develops at the tip of the mammary duct at the onset of puberty under the action of circulating hormones.</obo:IAO_0000115>
        <obo:UBPROP_0000010>terminal end buds (TEBs) consist of an outer layer of undifferentiated myoepithelial progenitor cells (&apos;cap cells&apos;), and a multilayered inner core of luminal epithelial cells (&apos;body&apos;) fated to form the walls of the ductal lumen; both layers have high rates of mitosis, consistent with a motile organ dedicated to ductal morphogenesis</obo:UBPROP_0000010>
        <obo:UBPROP_0000011>TEBs proliferate, ramify, and actively invade the fad pad to allow the formation of a complex branching structure; this process of branching morphogenesis concludes at ~10-12 weeks of age in mice, when TEBs have traversed the length of the fat pad and a fully developed ductal tree has formed</obo:UBPROP_0000011>
        <oboInOwl:hasDbXref>EMAPA:37900</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0005313</oboInOwl:id>
        <rdfs:label>mammary duct terminal end bud</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005313"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A unique club-shaped epithelial structure that develops at the tip of the mammary duct at the onset of puberty under the action of circulating hormones.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MGI:anna</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005313"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>EMAPA:37900</owl:annotatedTarget>
        <oboInOwl:source>MA:th</oboInOwl:source>
    </owl:Axiom>
    


