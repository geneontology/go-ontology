        <oboInOwl:hasExactSynonym>fibrous capsule of liver</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>glisson&apos;s capsule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hepatic capsule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunica fibrosa (hepar)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>tunica fibrosa hepatis</oboInOwl:hasExactSynonym>
