        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001077"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The transverse or costal processes of a vertebra, two in number, project one at either side from the point where the lamina joins the pedicle, between the superior and inferior articular processes. They serve for the attachment of muscles and ligaments. [WP,unvetted].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Transverse_process</oboInOwl:hasDbXref>
    </owl:Axiom>
