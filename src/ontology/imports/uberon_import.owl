        <rdfs:label>renal artery</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/d/da/Gray1120.png</foaf:depiction>
