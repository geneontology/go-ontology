    <!-- http://purl.obolibrary.org/obo/UBERON_0006860 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002075"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0018707"/>
        <rdfs:subClassOf>
