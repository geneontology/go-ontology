                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004187"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A merocrine secretion that is produced by a Harderian gland, containing lipids.</obo:IAO_0000115>
        <obo:UBPROP_0000008>in amphibians, chiefly seromucoid with some lipids[PMID:7559104]</obo:UBPROP_0000008>
        <obo:UBPROP_0000008>in birds, mucoid and lipid[PMID:7559104]</obo:UBPROP_0000008>
        <obo:UBPROP_0000008>in mammals, predominantly lipid; mucoid secretion restricted to extraglandular duct tissue[PMID:7559104]</obo:UBPROP_0000008>
        <obo:UBPROP_0000008>in the armadillo and opossum, mucous or serous acini may be present[PMID:7559104]</obo:UBPROP_0000008>
        <oboInOwl:hasExactSynonym>Harderian gland fluid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Harderian gland secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0022282</oboInOwl:id>
        <rdfs:label>secretion of Harderian gland</rdfs:label>
    </owl:Class>
