        <oboInOwl:hasDbXref>NCIT:C14128</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:362845002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0043425</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000830</oboInOwl:hasDbXref>
