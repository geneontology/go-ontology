        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0020101"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The deep auricular artery often arises in common with the anterior tympanic artery. It ascends in the substance of the parotid gland, behind the temporomandibular articulation, pierces the cartilaginous or bony wall of the external acoustic meatus, and supplies its cuticular lining and the outer surface of the tympanic membrane. It gives a branch to the temporomandibular joint.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:49689</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:147157007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Deep_auricular_artery</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0014695</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>deep auricular artery</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid41626">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002252"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001616"/>
    </owl:Restriction>
