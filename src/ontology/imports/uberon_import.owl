        <oboInOwl:hasDbXref>FMA:54533</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:9207</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002740</oboInOwl:hasDbXref>
