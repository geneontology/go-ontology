        <oboInOwl:hasDbXref>Wikipedia:Sphincter</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sphincter</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>circular muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004590</oboInOwl:id>
        <rdfs:label>sphincter muscle</rdfs:label>
    </owl:Class>
