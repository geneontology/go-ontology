        <oboInOwl:hasDbXref>galen:MetacarpoPhalangealJoint</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>MP joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>knuckle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>knuckles</oboInOwl:hasExactSynonym>
