    <!-- http://purl.obolibrary.org/obo/UBERON_0012453 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0012453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005162"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001027"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Specialized terminations of peripheral neurons. Nerve endings include NEUROEFFECTOR JUNCTION(s) by which neurons activate target organs and sensory receptors (see RECEPTORS, SENSORY) which transduce information from the various sensory modalities and send it centrally in the nervous system. Presynaptic nerve endings are PRESYNAPTIC TERMINALS.</obo:IAO_0000115>
        <obo:IAO_0000232>this class and subclasses may be ceded to GO</obo:IAO_0000232>
        <oboInOwl:hasDbXref>MESH:D009411</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>nerve ending</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0012453</oboInOwl:id>
        <rdfs:label>nerve ending</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012453"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Specialized terminations of peripheral neurons. Nerve endings include NEUROEFFECTOR JUNCTION(s) by which neurons activate target organs and sensory receptors (see RECEPTORS, SENSORY) which transduce information from the various sensory modalities and send it centrally in the nervous system. Presynaptic nerve endings are PRESYNAPTIC TERMINALS.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MESH:A08.800.550</oboInOwl:hasDbXref>
