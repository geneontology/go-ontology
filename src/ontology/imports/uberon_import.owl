        <oboInOwl:hasRelatedSynonym>pudendal venous plexus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0009042</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>prostatic venous plexus</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/bd/Gray585.png</foaf:depiction>
