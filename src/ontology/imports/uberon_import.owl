    <!-- http://purl.obolibrary.org/obo/UBERON_0001153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009854"/>
        <rdfs:subClassOf rdf:nodeID="genid4113"/>
        <rdfs:subClassOf rdf:nodeID="genid4115"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7776"/>
            </owl:Restriction>
        </rdfs:subClassOf>
