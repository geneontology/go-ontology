    <!-- http://purl.obolibrary.org/obo/UBERON_0005373 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005373">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016550"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002258"/>
            </owl:Restriction>
        </rdfs:subClassOf>
