        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0005107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005107">
