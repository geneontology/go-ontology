        <oboInOwl:hasDbXref>UMLS:C1710148</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000468</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pia mater of neuraxis of spinal cord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pia mater of spinal cord</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spinal cord pia mater of neuraxis</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0003555</oboInOwl:id>
