        <oboInOwl:hasDbXref>FMA:61889</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:672</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:4290</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000892</oboInOwl:hasDbXref>
