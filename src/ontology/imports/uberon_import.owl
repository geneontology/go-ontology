    <!-- http://purl.obolibrary.org/obo/UBERON_0003085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000947"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/uberon/core#channels_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000948"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ventral aorta is a blood vessel in a single-pass circulatory system that carries de-oxygenated blood from the heart to the gills. In a single-pass circulatory system blood passes once through the heart to supply the body once[GO].</obo:IAO_0000115>
        <obo:UBPROP_0000001>Outflow artery from the heart to the aortic arches. Kimmel et al, 1995.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000001>The artery in vertebrate embryos that carries blood from the ventricle of the heart to the aortic arches. In adult fish it branches into afferent branchial arteries supplying the gills. In adult tetrapods it is represented by the ascending part of the aorta.</obo:UBPROP_0000001>
        <obo:UBPROP_0000003>When vertebrates first appeared, they must have possessed a ventral and dorsal aorta with aortic arches between them.[well established][VHOG]</obo:UBPROP_0000003>
        <oboInOwl:hasDbXref>AAO:0010412</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BTO:0004674</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>TAO:0000604</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000121</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000338</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000604</oboInOwl:hasDbXref>
        <oboInOwl:id>UBERON:0003085</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:comment>Taxon notes (via vHOG): &quot;When vertebrates first appeared, they must have possessed a ventral and dorsal aorta with aortic arches between them.&quot; Liem KF, Bemis WE, Walker WF, Grande L, Functional Anatomy of the Vertebrates: An Evolutionary Perspective, Third Edition (2001) Orlando Fla.: Harcourt College Publishers, p.620. // in Reptiles, splits to form bases of 3 arteries: left aortic arch, right aortic arch and pulmonary trunk. In birds, the right systemic arch becomes predominant, the left never fully develops [Kardong]</rdfs:comment>
        <rdfs:label>ventral aorta</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The ventral aorta is a blood vessel in a single-pass circulatory system that carries de-oxygenated blood from the heart to the gills. In a single-pass circulatory system blood passes once through the heart to supply the body once[GO].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0035908</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Outflow artery from the heart to the aortic arches. Kimmel et al, 1995.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0000604</oboInOwl:external_class>
        <oboInOwl:ontology>TAO</oboInOwl:ontology>
        <oboInOwl:source>ZFIN:curator</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The artery in vertebrate embryos that carries blood from the ventricle of the heart to the aortic arches. In adult fish it branches into afferent branchial arteries supplying the gills. In adult tetrapods it is represented by the ascending part of the aorta.</owl:annotatedTarget>
        <oboInOwl:source>BTO:0004674</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>When vertebrates first appeared, they must have possessed a ventral and dorsal aorta with aortic arches between them.[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
        <oboInOwl:external_class>VHOG:0000121</oboInOwl:external_class>
        <oboInOwl:ontology>VHOG</oboInOwl:ontology>
        <oboInOwl:source>ISBN:978-0030223693 Liem KF, Bemis WE, Walker WF, Grande L, Functional Anatomy of the Vertebrates: An Evolutionary Perspective (2001) p.620</oboInOwl:source>
        <oboInOwl:source>http://bgee.unil.ch/</oboInOwl:source>
    </owl:Axiom>
    


