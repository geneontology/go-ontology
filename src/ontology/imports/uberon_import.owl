        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The outer epithelial layer of the external integument of the body that is derived from the embryonic epiblast.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0000143</oboInOwl:external_class>
