    <!-- http://purl.obolibrary.org/obo/UBERON_0005623 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000946"/>
        <obo:IAO_0000115>The valves that gate the flow of blood from the ventricles into the aorta and pulmonary trunk.</obo:IAO_0000115>
        <obo:UBPROP_0000003>Extensive conservation of valve developmental mechanisms also has been observed among vertebrate species including chicken, mouse, and human.[well established][VHOG]</obo:UBPROP_0000003>
        <obo:UBPROP_0000010>Lacks chordae tendinae</obo:UBPROP_0000010>
        <oboInOwl:hasDbXref>EHDAA2:0001823</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EHDAA:4408</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>EMAPA:35760</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002790</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001393</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>semilunar valve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>semilunar valves</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0005623</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>semi-lunar valve</rdfs:label>
