        </rdfs:subClassOf>
        <obo:IAO_0000115>Any of the lymph nodes that are part of a face.</obo:IAO_0000115>
        <obo:UBPROP_0000008>In humans, these comprise three groups: (a) infraorbital or maxillary, scattered over the infraorbital region from the groove between the nose and cheek to the zygomatic arch; (b) buccinator, one or more placed on the Buccinator opposite the angle of the mouth; (c) supramandibular, on the outer surface of the mandible, in front of the Masseter and in contact with the external maxillary artery and anterior facial vein.</obo:UBPROP_0000008>
        <oboInOwl:hasDbXref>FMA:61222</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279139005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Facial_lymph_nodes</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>buccal lymph node</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0015871</oboInOwl:id>
        <rdfs:label>facial lymph node</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015871"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
