        <owl:annotatedTarget>seminal plasma</owl:annotatedTarget>
        <oboInOwl:hasDbXref>BTO:0001232</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006530"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym"/>
        <owl:annotatedTarget>milt</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:31287811</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:35203131</oboInOwl:hasDbXref>
        <rdfs:comment>CURATOR NOTE A secretion from the glands of the male reproductive system in some aquatic animals that contains sperm and is sprayed onto the eggs.</rdfs:comment>
    </owl:Axiom>
