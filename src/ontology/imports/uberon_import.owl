        <obo:UBPROP_0000012>MA has distinct classes for &apos;tail bone&apos;, &apos;caudal vertebra&apos; and &apos;coccygeal vertebra&apos; but these may all be equivalent. This class may be obsoleted in future.</obo:UBPROP_0000012>
        <oboInOwl:hasDbXref>EMAPA:18042</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0000696</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>tail bone</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tail vertebra</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006068</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>bone of tail</rdfs:label>
    </owl:Class>
