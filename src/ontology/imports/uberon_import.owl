    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The outer epithelial layer of the skin that is superficial to the dermis.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0073040584</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
