        <oboInOwl:hasDbXref>SCTID:68477002</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>loose areolar connective tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>areolar tissue</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>loose connective tissue</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0006815</oboInOwl:id>
        <rdfs:label>areolar connective tissue</rdfs:label>
