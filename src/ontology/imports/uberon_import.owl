    <!-- http://purl.obolibrary.org/obo/UBERON_0001046 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001046">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004921"/>
        <rdfs:subClassOf rdf:nodeID="genid3452"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/uberon/core#proximally_connected_to"/>
