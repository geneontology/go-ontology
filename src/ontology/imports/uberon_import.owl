        <oboInOwl:date_retrieved>2012-08-14</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0000154</oboInOwl:external_class>
        <oboInOwl:ontology>TAO</oboInOwl:ontology>
        <oboInOwl:source>ZFIN:curator</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002063"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>Part of the circulatory system which receives blood from the systemic veins and contracts to pump the blood into the atrium of the heart.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0010505</oboInOwl:external_class>
        <oboInOwl:ontology>AAO</oboInOwl:ontology>
        <oboInOwl:source>AAO:BJB</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
