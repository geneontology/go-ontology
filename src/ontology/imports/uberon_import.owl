        <oboInOwl:hasDbXref>UMLS:C0040356</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Interphalangeal_articulations_of_the_foot</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>foot interphalangeal joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>hindlimb digit inter-phalangeal joint</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>interphalangeal joint of foot</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>interphalangeal joint of toe</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>toe joint</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0007721</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
