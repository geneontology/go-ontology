        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006862"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A diaphysis that is part of a femur[Automatically generated definition].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>OBOL:automatic</oboInOwl:hasDbXref>
