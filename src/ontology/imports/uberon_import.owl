    <!-- http://purl.obolibrary.org/obo/UBERON_0002538 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002530"/>
