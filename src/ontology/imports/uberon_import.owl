        <oboInOwl:hasExactSynonym>brainstem reticular formation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular formation (classical)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>reticular formation of the brainstem</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0002275</oboInOwl:id>
