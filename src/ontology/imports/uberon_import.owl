    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000471"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004119"/>
