        <owl:annotatedTarget>A neurogenic placode that arises at the level of the midbrain-hindbrain boundary and develops into a trigeminal ganglion.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:22512454</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://github.com/obophenotype/uberon/issues/693</oboInOwl:hasDbXref>
