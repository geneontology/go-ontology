            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001898"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The part of the hypothalamus posterior to the middle region consisting of several nuclei including the medial mamillary nucleus, lateral mamillary nucleus, and posterior hypothalamic nucleus (posterior hypothalamic area). The posterior hypothalamic area is concerned with control of sympathetic responses and is sensitive to conditions of decreasing temperature and controls the mechanisms for the conservation and increased production of heat.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>PHR</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasDbXref>BAMS:PH</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BAMS:PHR</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>BIRNLEX:1651</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:62029</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GAID:651</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>HBA:4665</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D007034</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0020670</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mammillary_process</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:411</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mammillary level of hypothalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mammillary region</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>posterior hypothalamus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>hypothalamus posterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>regio hypothalamica posterior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002770</oboInOwl:id>
        <rdfs:label>posterior hypothalamic region</rdfs:label>
    </owl:Class>
