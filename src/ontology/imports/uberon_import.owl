    <!-- http://purl.obolibrary.org/obo/UBERON_0022284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0022284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005153"/>
