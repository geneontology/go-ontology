        <rdfs:label>esophagus</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/d/d4/Illu01_head_neck.jpg</foaf:depiction>
