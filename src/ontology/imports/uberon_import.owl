        <oboInOwl:hasDbXref>UMLS:C0030518</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001188</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Parathyroid_gland</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000167</oboInOwl:hasDbXref>
