    <!-- http://purl.obolibrary.org/obo/UBERON_0003064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
        <rdfs:subClassOf rdf:nodeID="genid15464"/>
