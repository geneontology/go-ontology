        <oboInOwl:hasExactSynonym>medulla ovarii (zona vasculosa)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>zona vasculosa of Waldeyer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0013192</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>ovarian medulla</rdfs:label>
