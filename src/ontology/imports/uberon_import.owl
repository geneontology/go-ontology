        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002873"/>
        <obo:RO_0002171 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007633"/>
        <obo:UBPROP_0000015>WP says &apos;The CN is located at the dorso-lateral side of the brainstem, spanning the junction of the pons and medulla.&apos;. MA places this in pons, other sources the medulla</obo:UBPROP_0000015>
