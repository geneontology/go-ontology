        <oboInOwl:hasDbXref>MA:0000050</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:264228001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:361796005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001160</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VSAO:0005024</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Tarsus_(skeleton)</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0003211</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>hind mesopodial skeleton</oboInOwl:hasExactSynonym>
