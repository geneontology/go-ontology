        <oboInOwl:hasDbXref>NCIT:C32171</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181389002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0004456</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Axillary_vein</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:AxillaryVein</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>vena axillaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>subcostal vein</oboInOwl:hasRelatedSynonym>
