    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003114"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The third branchial arch contributes to the development of the hyoid bone, stylopharyngeus muscle, inferior parathyroid gland, and thymus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MP:0006339</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003114"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000001"/>
        <owl:annotatedTarget>The most anterior, or first, pharygeal/branchial arch, composed of the mandibular process, forming the posterior border of the stomodeum, and the maxillary process anterior to the stomodeum, contains the first aortic arch.[AAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-06-20</oboInOwl:date_retrieved>
        <oboInOwl:external_class>AAO:0010365</oboInOwl:external_class>
