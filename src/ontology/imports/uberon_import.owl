        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cranial nerve that transmits sound and equilibrium (balance) information from the inner ear to the brain.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0471209627</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Vestibulocochlear_nerve</oboInOwl:hasDbXref>
