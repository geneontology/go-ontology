        <oboInOwl:hasDbXref>XAO:0004002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001469</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lateral lines</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0010202</oboInOwl:id>
        <rdfs:label>lateral line</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid37021">
