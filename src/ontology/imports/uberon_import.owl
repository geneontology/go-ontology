        <oboInOwl:hasDbXref>NCIT:C49239</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1179154</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>epithelial tissue of gingiva</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epithelium of gingiva</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gingiva epithelial tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>gingiva epithelium</oboInOwl:hasExactSynonym>
