        <owl:annotatedTarget>synovial cavity of elbow joint</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:38911</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0004100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004100">
