        <oboInOwl:hasDbXref>VHOG:0000556</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pericardial_cavity</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0001655</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:PericardialSpace</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cavity of pericardial sac</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pericardial space</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cavitas pericardiaca</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001074</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#vertebrate_core"/>
        <rdfs:label>pericardial cavity</rdfs:label>
    </owl:Class>
