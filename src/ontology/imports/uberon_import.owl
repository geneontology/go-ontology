        <oboInOwl:hasDbXref>UMLS:C0231084</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000177</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Sinus_venosus</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0000154</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>sinus venarum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sinus venosus cordis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>venarum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>venarum sinus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>venosus</oboInOwl:hasRelatedSynonym>
