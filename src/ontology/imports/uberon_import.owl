    <!-- http://purl.obolibrary.org/obo/UBERON_0004153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002094"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010313"/>
        <rdfs:subClassOf rdf:nodeID="genid22007"/>
        <obo:IAO_0000115>Endocardial cushions project into the atrial canal, and, meeting in the middle line, unite to form the septum intermedium which divides the canal into two channels, the future right and left atrioventricular orifices[Gray&apos;s via WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>SCTID:361468003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Septum_intermedium</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>septum intermedium</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0004153</oboInOwl:id>
        <rdfs:label>ventricular septum intermedium</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/4/4d/Gray467.png</foaf:depiction>
    </owl:Class>
