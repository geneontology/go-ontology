        <oboInOwl:hasDbXref>SCTID:181184001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0013450</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000461</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Auditory_ossicle</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>XAO:0000214</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>auditory bone</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>middle ear ossicle</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>auditory ossicle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ear bone</oboInOwl:hasRelatedSynonym>
