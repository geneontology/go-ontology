        <oboInOwl:hasDbXref>Wikipedia:Tubercle_(anatomy)</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>tuber</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005813</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#grouping_class"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#upper_level"/>
        <rdfs:label>tubercle</rdfs:label>
    </owl:Class>
    <owl:Axiom>
