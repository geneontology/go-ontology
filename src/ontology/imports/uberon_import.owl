        <oboInOwl:hasRelatedSynonym>keilbein</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>os parasphenoidale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>os sphenoideum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>parabasale</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004745</oboInOwl:id>
        <rdfs:label>parasphenoid</rdfs:label>
    </owl:Class>
