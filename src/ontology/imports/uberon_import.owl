                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001225"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf rdf:nodeID="genid28432"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000451"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A compartment of the renal cortex situated between basement membranes of epithelia and vessels that contains two contiguous cellular networks in mutual contact, one formed by interstitial fibroblasts, the other by dendritic cells.</obo:IAO_0000115>
        <obo:UBPROP_0000010>In the renal cortex, interstitial fibroblasts produce erythropoietin and are distinguished from other interstitial cells by their prominent F-actin cytoskeleton, abundance of rough endoplasmic reticulum, and by ecto-5&apos;-nucleotidase expression in their plasma membrane. The resident dendritic cells belong to the mononuclear phagocyte system and fulfil a sentinel function. They are characterized by their expression of MHC class II and CD11c.</obo:UBPROP_0000010>
        <oboInOwl:hasDbXref>EMAPA:28136</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002608</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:243707006</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Medullary_interstitium</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>kidney cortex interstitium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>renal cortical interstitial tissue</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>cortical stroma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005270</oboInOwl:id>
        <rdfs:label>renal cortex interstitium</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid28432">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005215"/>
    </owl:Restriction>
