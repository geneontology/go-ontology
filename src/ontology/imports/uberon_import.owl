        <oboInOwl:hasExactSynonym>alveolar duct</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ductus alveolaris</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>respiratory alveolar duct</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0002173</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
