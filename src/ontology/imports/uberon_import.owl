        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000005"/>
        <owl:annotatedTarget>In ostariophysans, the dermopalatine is absent.[TAO]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-06</oboInOwl:date_retrieved>
        <oboInOwl:external_class>TAO:0000015</oboInOwl:external_class>
