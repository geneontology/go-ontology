    <!-- http://purl.obolibrary.org/obo/UBERON_0002285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002285">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0004086"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
