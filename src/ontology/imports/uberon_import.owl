    <!-- http://purl.obolibrary.org/obo/UBERON_0004649 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004649">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>
