    <!-- http://purl.obolibrary.org/obo/UBERON_0002490 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002490">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
