        <oboInOwl:hasDbXref>NCIT:C12957</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1516995</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Exocrine_gland</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WikipediaCategory:Exocrine_system</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>exocrine glandular system</oboInOwl:hasExactSynonym>
