            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004134"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cells lining the proximal tubule are cuboidal epithelial cells with deep basal membrane invaginations that provide a large basal surface area. The long microvilli (the brush border) lining the tubule lumen, maximize luminal surface area and make these cells ideally suited for both reabsorptive and secretory functions.</obo:IAO_0000115>
        <obo:IAO_0000116>See https://github.com/obophenotype/uberon/issues/1305</obo:IAO_0000116>
        <oboInOwl:hasDbXref>BTO:0003576</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:64808</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>epithelium of proximal convoluted tubule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>epithelium of proximal renal tubule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>proximal renal tubule epithelium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>proximale tubular epithelium</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>proximal tubule epithelium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0008404</oboInOwl:id>
        <rdfs:label>proximal tubular epithelium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008404"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The cells lining the proximal tubule are cuboidal epithelial cells with deep basal membrane invaginations that provide a large basal surface area. The long microvilli (the brush border) lining the tubule lumen, maximize luminal surface area and make these cells ideally suited for both reabsorptive and secretory functions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Renal_Physiology:Section_7</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>_Chapter_3</oboInOwl:hasDbXref>
    </owl:Axiom>
