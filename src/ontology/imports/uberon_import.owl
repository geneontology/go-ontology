    <!-- http://purl.obolibrary.org/obo/UBERON_0007160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0017635"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002170"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001586"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The inferior petrosal sinus, within the human head, is an area beneath the brain, which allows blood veins to span the area, from the center of the head downward. It drains from the cavernous sinus (beneath the brain) to the sigmoid sinuses above the internal jugular vein.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EMAPA:19234</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:50770</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:279263009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Inferior_petrosal_sinus</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>sinus petrosal inferior</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0007160</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>inferior petrosal sinus</rdfs:label>
    </owl:Class>
    <owl:Axiom>
