        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
