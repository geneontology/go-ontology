        <oboInOwl:hasDbXref>UMLS:C0022655</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Renal_cortex</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:CortexOfKidney</oboInOwl:hasDbXref>
