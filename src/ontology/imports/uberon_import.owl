    <!-- http://purl.obolibrary.org/obo/UBERON_0007277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007277">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
