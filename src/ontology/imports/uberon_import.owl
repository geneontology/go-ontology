        <oboInOwl:hasDbXref>UMLS:C1280559</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Pharyngeal_groove</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>pharyngeal groove ectoderm</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>gill cleft</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>Kiemenspalten</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>branchial cleft</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>branchial groove</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pharyngeal ectodermal cleft</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pharyngeal slit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sulcus pharyngei</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005879</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>pharyngeal cleft</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/2/20/Kiemenbogen.jpg</foaf:depiction>
