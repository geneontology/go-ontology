    <!-- http://purl.obolibrary.org/obo/UBERON_0007106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000478"/>
