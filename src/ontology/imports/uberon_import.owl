        <rdfs:label>dentate nucleus</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/2/23/Gray707.png</foaf:depiction>
