        <oboInOwl:id>UBERON:0014401</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:label>renal venous blood vessel</rdfs:label>
    </owl:Class>
