        <owl:annotatedTarget>A small motor nerve which emerges from the lateral wall of the medulla with the roots of the vagus nerve, and innervates a single pectoral suspensory muscle, the m.cucullaris.</owl:annotatedTarget>
        <oboInOwl:source>ISBN:080184780X</oboInOwl:source>
        <oboInOwl:source>XAO:0004214</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
