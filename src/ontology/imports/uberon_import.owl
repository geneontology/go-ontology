        <rdfs:label>cloacal membrane</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/d/d2/Gray991.png</foaf:depiction>
    </owl:Class>
