        <oboInOwl:hasDbXref>SCTID:70402007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0682664</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Sensory_receptor</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>peripheral ending of sensory neuron</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>sensory nerve ending</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0012451</oboInOwl:id>
        <rdfs:label>sensory receptor</rdfs:label>
    </owl:Class>
