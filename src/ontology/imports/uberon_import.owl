        <oboInOwl:hasDbXref>MAT:0000117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D060910</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MIAA:0000117</oboInOwl:hasDbXref>
