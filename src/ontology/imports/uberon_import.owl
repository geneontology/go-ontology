            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A bodily secretion that is produced by the prostate gland.</obo:IAO_0000115>
        <obo:UBPROP_0000008>Prostatic secretions vary among species. They are generally composed of simple sugars and are often slightly alkaline.</obo:UBPROP_0000008>
        <obo:UBPROP_0000010>A secretion of the prostate this is slightly alkaline fluid, milky or white in appearance. Usually constitutes 20-30% of the volume of the semen along with spermatozoa and seminal vesicle fluid [Wikipedia:Prostate#Secretions]</obo:UBPROP_0000010>
        <oboInOwl:hasAlternativeId>UBERON:0010142</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>EMAPA:36545</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:66884</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MA:0002525</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C52553</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1709733</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Prostate#Secretions</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>prostate secretion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>prostatic fluid</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>secretion of prostate</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>secretion of prostate gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>prostate fluid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004796</oboInOwl:id>
        <rdfs:label>prostate gland secretion</rdfs:label>
