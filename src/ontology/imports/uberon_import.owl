        <owl:annotatedTarget>A bone that is part of the carpal skeleton. Examples: scaphoid, lunate, capitate[cjm].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
