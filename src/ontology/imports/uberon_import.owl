    <!-- http://purl.obolibrary.org/obo/UBERON_0002314 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002616"/>
