        <oboInOwl:hasDbXref>ZFA:0000143</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>retina photoreceptor layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>retinal photoreceptor layer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum segmentorum externorum et internorum (retina)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stratum segmentorum externorum et internorum retinae</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>layer of rods and cones</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retinal photoreceptor layers</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001787</oboInOwl:id>
