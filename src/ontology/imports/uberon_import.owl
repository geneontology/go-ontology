        <owl:annotatedTarget>The female muscular organ of gestation in which the developing embryo or fetus is nourished until birth.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>MGI:csmith</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MP:0001120</oboInOwl:hasDbXref>
