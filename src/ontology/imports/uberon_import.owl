    <!-- http://purl.obolibrary.org/obo/UBERON_0007383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000490"/>
