        <owl:annotatedTarget>A phalanx located between proximal and distal phalanges.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://orcid.org/0000-0002-6601-2165</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
