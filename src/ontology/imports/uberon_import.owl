        <oboInOwl:hasDbXref>ZFA:0005064</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>galen:AtrioventricularValve</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>AV valve</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>atrio-ventricular valve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0002133</oboInOwl:id>
