        <oboInOwl:hasDbXref>SCTID:245434005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0227658</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Ascending_limb_of_loop_of_Henle</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>ascending limb of Henle&apos;s loop</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>loop of Henle ascending limb</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>distal straight tubule</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0005164</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#uberon_slim"/>
        <rdfs:label>ascending limb of loop of Henle</rdfs:label>
    </owl:Class>
