        <oboInOwl:hasDbXref>NCIT:C12769</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:181616008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C1704247</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0000852</oboInOwl:hasDbXref>
