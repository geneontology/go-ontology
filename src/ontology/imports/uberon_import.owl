    <!-- http://purl.obolibrary.org/obo/UBERON_0003946 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005156"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001987"/>
            </owl:Restriction>
        </rdfs:subClassOf>
