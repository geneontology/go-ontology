        <oboInOwl:hasDbXref>VHOG:0000331</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Calvaria_(skull)</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0005606</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>calva</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cranial vault</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>skull vault</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>skull roof</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>calvaria</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>calvarium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>skullcap</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0004339</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
        <rdfs:comment>Terminology notes. we include calvarium as a synonym, but Gray&apos;s Anatomy&apos;s list includes the Ethmoid and Sphenoid bone in the Calvaria. Some books (and HPO) state that calvaria consists of just the frontal bone, parietal bone, temporal bone, and occipital bone. Note vault may not be precisely equivalent to calvaria</rdfs:comment>
        <rdfs:label>vault of skull</rdfs:label>
    </owl:Class>
