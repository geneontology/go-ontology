    <!-- http://purl.obolibrary.org/obo/UBERON_0006777 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002050"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009616"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Embryologic structure that is formed by two longitudinal eminences, one on each alar plate of the midbrain. These eminences become the superior colliculus and inferior colliculus ( Carpenter-1983 )].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:77488</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1374</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>lamina quadrigemina</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>quadrigeminal plate</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0006777</oboInOwl:id>
        <rdfs:comment>The term &quot;tectal plate&quot; (or &quot;quadrigeminal plate&quot;) is used to describe the junction of the gray and white matter in the embryo. (NeuroNames ancil-453)</rdfs:comment>
        <rdfs:label>tectal plate</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006777"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Embryologic structure that is formed by two longitudinal eminences, one on each alar plate of the midbrain. These eminences become the superior colliculus and inferior colliculus ( Carpenter-1983 )].</owl:annotatedTarget>
        <oboInOwl:hasDbXref>http://braininfo.rprc.washington.edu/centraldirectory.aspx?type=a&amp;ID=453</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006777"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>lamina quadrigemina</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FMA:77488</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:TA</oboInOwl:hasDbXref>
