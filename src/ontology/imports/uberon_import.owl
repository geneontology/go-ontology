    <!-- http://purl.obolibrary.org/obo/UBERON_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004923"/>
