        <oboInOwl:hasRelatedSynonym>arteria mesenterica inferior</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0001183</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
