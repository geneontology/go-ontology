        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015050"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002202"/>
