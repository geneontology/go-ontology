        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002376"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001361"/>
    </owl:Restriction>
