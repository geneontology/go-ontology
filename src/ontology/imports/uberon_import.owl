        <oboInOwl:hasExactSynonym>glomerular filtration membrane</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0005777</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#pheno_slim"/>
