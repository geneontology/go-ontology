        <owl:annotatedTarget>crista neuralis</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Neural_crest</oboInOwl:hasDbXref>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003011"/>
    </owl:Axiom>
