    <!-- http://purl.obolibrary.org/obo/UBERON_0001602 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006533"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002376"/>
