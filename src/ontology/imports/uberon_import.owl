        <oboInOwl:hasExactSynonym>thalamic fasciculus [h1]</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0022254</oboInOwl:id>
        <rdfs:label>ventral thalamic fasciculus</rdfs:label>
    </owl:Class>
