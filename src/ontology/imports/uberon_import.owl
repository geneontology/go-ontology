    <!-- http://purl.obolibrary.org/obo/UBERON_0002518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006585"/>
        <rdfs:subClassOf>
