        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000003"/>
        <owl:annotatedTarget>In the primitive vertebrate heart the four chambers are: 1. Sinus venosus (...) 2. Atrium (...) 3. Ventricle (...) 4. Conus arteriosus (...).[well established][VHOG]</owl:annotatedTarget>
        <oboInOwl:date_retrieved>2012-09-17</oboInOwl:date_retrieved>
