    <!-- http://purl.obolibrary.org/obo/UBERON_0003903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004177"/>
