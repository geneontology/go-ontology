        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/UBPROP_0000009"/>
        <owl:annotatedTarget>The loop of Henle plays an important role in creating a concentration gradient in the medulla of the kidney. It is involved in reabsorption of filtered water and ions including sodium, potassium and calcium, and independently regulates both the volume and osmolarity of body fluids.</owl:annotatedTarget>
        <oboInOwl:source>DOI:10.1371/journal.pone.0099864</oboInOwl:source>
    </owl:Axiom>
