    <!-- http://purl.obolibrary.org/obo/UBERON_0003712 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005486"/>
