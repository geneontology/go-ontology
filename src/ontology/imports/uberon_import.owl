    <!-- http://purl.obolibrary.org/obo/UBERON_0001681 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001681">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002514"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003462"/>
