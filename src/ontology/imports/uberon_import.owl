    <!-- http://purl.obolibrary.org/obo/UBERON_0002380 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001482"/>
