    <!-- http://purl.obolibrary.org/obo/UBERON_0013218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002049"/>
        <obo:IAO_0000115>A rete mirabile (Latin for &apos;wonderful net&apos;; plural retia mirabilia) is a complex of arteries and veins lying very close to each other, found in some vertebrates. The rete mirabile utilizes countercurrent blood flow within the net (blood flowing in opposite directions. ) It exchanges heat, ions, or gases between vessel walls so that the two bloodstreams within the rete maintain a gradient with respect to temperature, or concentration of gases or solutes.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>BTO:0006363</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:76728</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Rete_mirabile</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>red body</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>red gland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rete mirabilia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>rete mirabilis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>retie mirabilia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>wonderful net</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>UBERON:0013218</oboInOwl:id>
        <rdfs:comment>GAT in FMA</rdfs:comment>
        <rdfs:label>rete mirabile</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013218"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A rete mirabile (Latin for &apos;wonderful net&apos;; plural retia mirabilia) is a complex of arteries and veins lying very close to each other, found in some vertebrates. The rete mirabile utilizes countercurrent blood flow within the net (blood flowing in opposite directions. ) It exchanges heat, ions, or gases between vessel walls so that the two bloodstreams within the rete maintain a gradient with respect to temperature, or concentration of gases or solutes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>Wikipedia:Rete_mirabile</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013218"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>BTO:0006363</owl:annotatedTarget>
        <pav:authoredBy rdf:resource="https://orcid.org/0000-0003-4423-4370"/>
