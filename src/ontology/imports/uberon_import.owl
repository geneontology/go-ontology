    <!-- http://purl.obolibrary.org/obo/UBERON_0006009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000064"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000946"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The part of the heart valves that serves to seal the heart valves when closed. There are three cusps for each valve except for the mitral valve, which has only two (hence its alternate name, &apos;bicuspid valve&apos;). &apos;Nodules&apos; are located at the tip of the valve, to form a tighter seal[WP].</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:7232</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C33849</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:30822008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>UMLS:C0225923</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cusps_of_heart_valves</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>cardiac valve cusp</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cardiac valvular cusp</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cardiac valvule</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cardial valve cusp</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>semilunar valvule</oboInOwl:hasExactSynonym>
        <oboInOwl:id>UBERON:0006009</oboInOwl:id>
        <rdfs:label>cusp of cardiac valve</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/50/Gray495.png</foaf:depiction>
    </owl:Class>
