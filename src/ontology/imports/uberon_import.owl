    <!-- http://purl.obolibrary.org/obo/UBERON_0001876 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002420"/>
