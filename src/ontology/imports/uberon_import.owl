    <!-- http://purl.obolibrary.org/obo/UBERON_0004179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005156"/>
