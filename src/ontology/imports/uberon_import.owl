        <oboInOwl:hasDbXref>SCTID:368955007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>VHOG:0001183</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Spiral_ganglion</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>neuronames:1405</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Corti&apos;s ganglion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>cochlear part of vestibulocochlear ganglion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ganglion of Corti</oboInOwl:hasExactSynonym>
