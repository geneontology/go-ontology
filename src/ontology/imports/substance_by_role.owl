    <!-- http://purl.obolibrary.org/obo/GOCHE_49205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GOCHE_49205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_35222"/>
