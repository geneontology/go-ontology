    <!-- http://purl.obolibrary.org/obo/GOCHE_78433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GOCHE_78433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_33232"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_78433"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A substance used in a thermodynamic heat pump cycle or refrigeration cycle that undergoes a phase change from a gas to a liquid and back. Refrigerants are used in air-conditioning systems and freezers or refrigerators and are assigned a &quot;R&quot; number (by ASHRAE - formerly the American Society of Heating, Refrigerating and Air Conditioning Engineers), which is determined systematically according to their molecular structure.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>wikipedia.en:Refrigerant</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>refrigerants</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GOCHE:78433</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>substance with refrigerant role</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GOCHE_78433"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasDbXref"/>
        <owl:annotatedTarget>wikipedia.en:Refrigerant</owl:annotatedTarget>
        <oboInOwl:source>wikipedia.en</oboInOwl:source>
    </owl:Axiom>
    <owl:Axiom>
