    <!-- http://purl.obolibrary.org/obo/GOCHE_50684 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GOCHE_50684">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_33893"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50684"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A reagent with two reactive groups, usually at opposite ends of the molecule, that are capable of reacting with and thereby forming bridges between macromolecules, principally side chains of amino acids in proteins, allowing the locations of naturally reactive areas within the proteins to be identified.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cross-linking reagents</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GOCHE:50684</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>substance with cross-linking reagent role</rdfs:label>
    </owl:Class>
    <owl:Axiom>
