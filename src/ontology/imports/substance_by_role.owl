    <!-- http://purl.obolibrary.org/obo/GOCHE_50949 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GOCHE_50949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_48278"/>
        <rdfs:subClassOf>
            <owl:Restriction>
