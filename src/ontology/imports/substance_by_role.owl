        <oboInOwl:hasRelatedSynonym>signalling molecules</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GOCHE:62488</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>substance with signalling molecule role</rdfs:label>
    </owl:Class>
