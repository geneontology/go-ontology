    <!-- http://purl.obolibrary.org/obo/GOCHE_50268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GOCHE_50268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_38632"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_51374"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_50268"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A substance that does not act as agonist or antagonist but does affect the gamma-aminobutyric acid receptor-ionophore complex. GABA-A receptors appear to have at least three allosteric sites at which modulators act: a site at which benzodiazepines act by increasing the opening frequency of gamma-aminobutyric acid-activated chloride channels; a site at which barbiturates act to prolong the duration of channel opening; and a site at which some steroids may act.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>GABA modulators</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GOCHE:50268</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>substance with GABA modulator role</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GOCHE_50268"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GABA modulators</owl:annotatedTarget>
        <oboInOwl:hasDbXref>chebi</oboInOwl:hasDbXref>
    </owl:Axiom>
    


