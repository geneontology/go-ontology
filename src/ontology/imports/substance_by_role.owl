        <oboInOwl:hasRelatedSynonym>HMG-CoA reductase inhibitor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HMG-CoA reductase inhibitors</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>hydroxymethylglutaryl-CoA reductase inhibitor</oboInOwl:hasRelatedSynonym>
