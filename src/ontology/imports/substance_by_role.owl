    <!-- http://purl.obolibrary.org/obo/GOCHE_35705 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GOCHE_35705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_50846"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35705"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An agent that suppresses immune function by one of several mechanisms of action. Classical cytotoxic immunosuppressants act by inhibiting DNA synthesis. Others may act through activation of T-cells or by inhibiting the activation of helper cells. In addition, an immunosuppressive agent is a role played by a compound which is exhibited by a capability to diminish the extent and/or voracity of an immune response.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>immunosuppressant</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>immunosuppressive agents</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>inmunosupresor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GOCHE:35705</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>substance with immunosuppressive agent role</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GOCHE_35705"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
