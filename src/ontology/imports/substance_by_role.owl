    <!-- http://purl.obolibrary.org/obo/GOCHE_64345 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GOCHE_64345">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24431"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GOCHE_33232"/>
