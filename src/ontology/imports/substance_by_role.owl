        <oboInOwl:hasRelatedSynonym>NMDA receptor antagonists</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NMDAR antagonist</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NMDAR antagonists</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GOCHE:60643</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>substance with NMDA receptor antagonist role</rdfs:label>
