        <oboInOwl:hasRelatedSynonym>dopamine reuptake inhibitor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dopamine reuptake inhibitors</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dopamine uptake inhibitors</oboInOwl:hasRelatedSynonym>
