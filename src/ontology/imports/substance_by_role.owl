        <oboInOwl:hasRelatedSynonym>intercalating ligands</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>intercalators</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GOCHE:24853</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/3_STAR"/>
        <rdfs:label>substance with intercalator role</rdfs:label>
    </owl:Class>
