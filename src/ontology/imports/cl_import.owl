        <oboInOwl:hasDbXref>ZFA:0009390</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#kidney_upper_slim"/>
        <rdfs:label>kidney interstitial cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1000500</rdfs:seeAlso>
    </owl:Class>
