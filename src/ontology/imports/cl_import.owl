        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002215"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042634"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A bipotent mesenchymal stem cell that resides in the dermal sheath, specifically within the dermal sheath cup at the base of the hair follicle, characterized by its capacity for self-renewal and differentiation into both dermal sheath and dermal papilla cells throughout hair cycling. In humans, this cell is marked by enriched expression of gremlin-2 (GREM2) and dipeptidase-1 (DPEP1), and acts as a progenitor reservoir sustaining and regenerating the follicle&apos;s mesenchymal compartments.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-11-05T11:49:53Z</oboInOwl:creation_date>
        <oboInOwl:hasNarrowSynonym>dermal sheath cup cell</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasRelatedSynonym>hfDSC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hair follicle dermal stem cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_4072103"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A bipotent mesenchymal stem cell that resides in the dermal sheath, specifically within the dermal sheath cup at the base of the hair follicle, characterized by its capacity for self-renewal and differentiation into both dermal sheath and dermal papilla cells throughout hair cycling. In humans, this cell is marked by enriched expression of gremlin-2 (GREM2) and dipeptidase-1 (DPEP1), and acts as a progenitor reservoir sustaining and regenerating the follicle&apos;s mesenchymal compartments.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:25465495</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:29691589</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:35036581</oboInOwl:hasDbXref>
