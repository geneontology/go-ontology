        <oboInOwl:hasExactSynonym>CD4-positive, alpha-beta immature T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD4-positive, alpha-beta immature T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SP CD4 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>CD4-positive, alpha-beta thymocyte</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000810</rdfs:seeAlso>
    </owl:Class>
