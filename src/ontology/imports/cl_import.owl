        <oboInOwl:hasDbXref>ZFA:0009282</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Bergmann astrocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Bergmann glial cell of cerebellum</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>Bergmann glial cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000644</rdfs:seeAlso>
        <foaf:depiction rdf:resource="http://purl.obolibrary.org/obo/cl/images/Candelabrum_cell.jpg"/>
    </owl:Class>
