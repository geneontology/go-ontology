        <oboInOwl:hasDbXref>CALOHA:TS-0868</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FBbt:00004211</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:86740</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009127</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>photoreceptor cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000210</rdfs:seeAlso>
        <skos:prefLabel>photoreceptor cell</skos:prefLabel>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.swissbiopics.org/api/image/Photoreceptor_cell.svg</foaf:depiction>
    </owl:Class>
