        <oboInOwl:hasDbXref>ZFA:0009308</oboInOwl:hasDbXref>
        <oboInOwl:hasNarrowSynonym>urinary tract transitional epithelial cell</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>urothelial cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000731</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000731"/>
