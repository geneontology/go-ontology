        <oboInOwl:hasDbXref>DOI:10.1093/jmcb/mjr043</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1111/imr.12170</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3389/fmed.2023.1244298</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
