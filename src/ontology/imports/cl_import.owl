        <oboInOwl:hasDbXref>FMA:83132</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D004759</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>Kulchitsky cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>argentaffin cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>enterochromaffin cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>type EC enteroendocrine cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000577</rdfs:seeAlso>
    </owl:Class>
