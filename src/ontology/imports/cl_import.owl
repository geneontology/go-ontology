        <oboInOwl:hasExactSynonym>pancreatic D-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pancreatic delta cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>somatostatin-secreting pancreatic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>pancreatic D cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000173</rdfs:seeAlso>
