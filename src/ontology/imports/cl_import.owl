        <oboInOwl:hasDbXref>DOI:10.1242/dev.114215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.5966/sctm.2015-0051</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0005026"/>
