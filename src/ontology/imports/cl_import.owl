        <obo:IAO_0000115>A specialized muscle nucleus that is part of an extrafusal muscle fiber, clustered at the postsynaptic side of the neuromuscular junction. This nucleus exhibits a distinct transcriptional profile, including acetylcholine receptor (AChR) subunit genes. It regulates the production of proteins essential for maintaining the structure and function of the neuromuscular junction, supporting efficient nerve-muscle signaling for muscle contraction.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0009-0000-8480-9277"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0001-6947-615X"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-10-31T11:09:04Z</terms:date>
        <oboInOwl:hasExactSynonym>neuromuscular junction myonuclei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>neuromuscular junction nuclei</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>NMJ nuclues</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>neuromuscular junction nucleus</rdfs:label>
    </owl:Class>
