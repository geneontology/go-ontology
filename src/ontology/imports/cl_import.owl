        <oboInOwl:hasDbXref>FMA:70967</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009285</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>glomerular podocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>glomerular visceral epithelial cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>kidney podocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>renal podocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
