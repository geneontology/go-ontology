        <oboInOwl:hasDbXref>DOI:10.1016/j.heliyon.2023.e19428</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1164/rccm.200706-929OC</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1513/AnnalsATS.201605-341AW</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3390/ijms20061461</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
