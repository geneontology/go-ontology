        <oboInOwl:hasExactSynonym>megakaryocyte/erythroid progenitor cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
