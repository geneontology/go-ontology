        <owl:annotatedTarget>A mesangial cell located among the glomerular capillaries in a renal corpuscle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref rdf:resource="https://doi.org/10.1152/physrev.1998.78.3.723"/>
