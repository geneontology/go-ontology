    <!-- http://purl.obolibrary.org/obo/CL_0000499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
