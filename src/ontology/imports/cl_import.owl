        <oboInOwl:hasRelatedSynonym>committed lymphopoietic stem cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>early lymphocyte progenitor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lymphoid stem cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lymphopoietic stem cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
