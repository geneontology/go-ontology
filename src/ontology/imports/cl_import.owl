        <oboInOwl:hasRelatedSynonym>salivary gland glandular cells</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>salivary gland glandular cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1001596</rdfs:seeAlso>
    </owl:Class>
