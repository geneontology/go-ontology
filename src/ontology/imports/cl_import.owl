        <oboInOwl:hasExactSynonym>mature alpha-beta T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mature alpha-beta T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>mature alpha-beta T cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000791</rdfs:seeAlso>
    </owl:Class>
