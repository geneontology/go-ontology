        <oboInOwl:hasDbXref>DOI:10.1038/s41586-023-06002-x</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3389/fimmu.2020.00269</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3389/fimmu.2021.708186</oboInOwl:hasDbXref>
    </owl:Axiom>
