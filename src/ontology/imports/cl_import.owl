    <!-- http://purl.obolibrary.org/obo/CL_4033083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4033083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000076"/>
