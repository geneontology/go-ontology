        <oboInOwl:hasDbXref>MESH:D053687</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009307</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>somatic stem cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000723</rdfs:seeAlso>
        <skos:prefLabel>somatic stem cell</skos:prefLabel>
    </owl:Class>
