        <oboInOwl:hasExactSynonym>hepatic dendritic cell</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CL:2000055</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>http://www.jleukbio.org/content/66/2/322.abstract</rdfs:comment>
        <rdfs:label>liver dendritic cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_2000055</rdfs:seeAlso>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_2000055"/>
