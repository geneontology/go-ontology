        <oboInOwl:hasExactSynonym>enterocyte of colon</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>vacuolar absorptive cell of epithelium of colon</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>colonocyte</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1000347</rdfs:seeAlso>
    </owl:Class>
