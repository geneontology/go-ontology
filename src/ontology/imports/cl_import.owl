        <oboInOwl:hasDbXref>ZFA:0009140</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>phagocyte</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000234</rdfs:seeAlso>
    </owl:Class>
