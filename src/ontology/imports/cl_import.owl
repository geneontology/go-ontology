        <owl:annotatedTarget>A GABAergic interneuron whose soma is located in the cerebral cortex.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:dos</oboInOwl:hasDbXref>
    </owl:Axiom>
