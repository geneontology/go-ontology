        <oboInOwl:hasDbXref>BTO:0004577</oboInOwl:hasDbXref>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>aortic smooth muscle cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0002539</rdfs:seeAlso>
    </owl:Class>
