                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CL_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any fibroblast that is derived from the neural crest.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>fibroblast neural crest derived</oboInOwl:hasExactSynonym>
        <rdfs:label>neural crest derived fibroblast</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0000005"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
