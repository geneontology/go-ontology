        <oboInOwl:hasDbXref>FMA:70585</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>MESH:D050416</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009104</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>alpha cell of islet of Langerhans</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pancreatic alpha cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>pancreatic A cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000171</rdfs:seeAlso>
        <foaf:depiction>https://cdn.humanatlas.io/digital-objects/2d-ftu/pancreas-islets-langerhans/v1.2/assets/2d-ftu-pancreas-islets-langerhans.png</foaf:depiction>
    </owl:Class>
