        <oboInOwl:hasBroadSynonym>alveolar progenitor</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>luminal progenitor</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>luminal progenitor cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasBroadSynonym>luminal secretory cell</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>ER-negative luminal alveolar progenitor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>AP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LASP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LumSec</oboInOwl:hasRelatedSynonym>
