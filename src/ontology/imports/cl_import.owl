    <!-- http://purl.obolibrary.org/obo/CL_0000448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000136"/>
