        <oboInOwl:hasRelatedSynonym>CD8-positive, alpha-beta immature T cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
