        <oboInOwl:hasDbXref>DOI:10.1172/JCI22991</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3389/fimmu.2021.717884</oboInOwl:hasDbXref>
    </owl:Axiom>
