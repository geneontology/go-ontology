    <!-- http://purl.obolibrary.org/obo/CL_4052001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_4052001">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CL_0000075"/>
