        <oboInOwl:hasExactSynonym>hemopoietic progenitor cell</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#blood_and_immune_upper_slim"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>Markers differ between mouse and human.</rdfs:comment>
        <rdfs:label>hematopoietic multipotent progenitor cell</rdfs:label>
        <skos:prefLabel>hematopoietic multipotent progenitor cell</skos:prefLabel>
