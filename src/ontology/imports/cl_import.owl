        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_1000612"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
