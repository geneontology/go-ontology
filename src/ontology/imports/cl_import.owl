        <oboInOwl:hasExactSynonym>mature gamma-delta T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>mature gamma-delta T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>mature gamma-delta T cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000800</rdfs:seeAlso>
    </owl:Class>
