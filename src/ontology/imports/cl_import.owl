    <!-- http://purl.obolibrary.org/obo/CL_0002620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002620">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
