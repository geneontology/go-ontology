        <oboInOwl:hasDbXref>DOI:10.1016/B978-0-323-35775-3.00011-4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1146/annurev-physiol-052521-121841</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1681/ASN.2012010029</oboInOwl:hasDbXref>
    </owl:Axiom>
