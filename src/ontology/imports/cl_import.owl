        <oboInOwl:hasDbXref>FMA:63379</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>stem cell of intestinal crypt of Lieberkuhn</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>intestinal crypt stem cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0002250</rdfs:seeAlso>
    </owl:Class>
