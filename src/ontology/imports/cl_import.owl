        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>blood vessel endothelial cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000071</rdfs:seeAlso>
        <skos:prefLabel>blood vessel endothelial cell</skos:prefLabel>
    </owl:Class>
