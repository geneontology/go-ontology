        </rdfs:subClassOf>
        <obo:IAO_0000115>A supporting cell that is part of the ovary and differentiates into a granulosa cell. A pre-granulosa cell develops from an early supporting gonadal cell by repressing testis determination, which can then proliferate to form primordial follicles.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-7655-4833"/>
