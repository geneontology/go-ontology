        <oboInOwl:hasRelatedSynonym>ELP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GMLP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LMPP</oboInOwl:hasRelatedSynonym>
