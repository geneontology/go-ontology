        <owl:annotatedTarget>https://cellxgene.cziscience.com/cellguide/CL_0000129</owl:annotatedTarget>
        <rdfs:label>microglial cell on CELLxGENE CellGuide</rdfs:label>
    </owl:Axiom>
    


