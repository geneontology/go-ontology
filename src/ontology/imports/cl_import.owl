    <!-- http://purl.obolibrary.org/obo/CL_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000034">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
