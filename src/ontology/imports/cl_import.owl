    <!-- http://purl.obolibrary.org/obo/CL_0020030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0020030">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
