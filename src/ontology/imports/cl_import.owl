        <obo:IAO_0000115>A pigment cell derived from the neural crest. Contains uric acid or other purine crystals deposited in stacks called leucosomes. The crystals reflect light and this gives a white appearance under white light.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ZFA:0009261</oboInOwl:hasDbXref>
        <rdfs:label>leucophore</rdfs:label>
    </owl:Class>
