        <oboInOwl:hasDbXref>ZFA:0009251</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>colony forming unit granulocyte macrophage</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>granulocyte-macrophage progenitor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>granulocyte/monocyte precursor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>granulocyte/monocyte progenitor</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>CFU-GM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GMP</oboInOwl:hasRelatedSynonym>
