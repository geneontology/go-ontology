    <!-- http://purl.obolibrary.org/obo/CL_0002192 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000763"/>
