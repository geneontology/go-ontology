        <obo:IAO_0000115>A neuroepithelial cells that occurs singly or in small groups, close to the outer follicular borders but within the follicular basement membrane of the thyroid. This cell expresses a form of the neural cell adhesion molecule (N-CAM) on its surface and secretes calcitonin and serotonin (5-hydroxytryptamine).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>FMA:68653</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>SCTID:176770005</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009260</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>C cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>C cell of thyroid gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>clear cell of thyroid gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>parafollicular cell of thyroid gland</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>thyroid parafollicular cell</oboInOwl:hasExactSynonym>
        <rdfs:label>parafollicular cell</rdfs:label>
    </owl:Class>
