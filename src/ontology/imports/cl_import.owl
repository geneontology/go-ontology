        <obo:IAO_0000115>A pigment cell derived from the neural crest. Contains pteridine and/or carotenoid pigments in structures called pterinosomes or erythrosomes. This gives an orange to red appearance.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ZFA:0009263</oboInOwl:hasDbXref>
        <rdfs:label>erythrophore</rdfs:label>
    </owl:Class>
