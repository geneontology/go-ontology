        <oboInOwl:hasDbXref>DOI:10.1038/s41574-021-00491-4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1152/ajpendo.00100.2011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/books/NBK278945/</oboInOwl:hasDbXref>
