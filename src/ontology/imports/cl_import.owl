        <oboInOwl:hasDbXref>DOI:10.1016/j.blre.2014.10.003</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1038/s41569-018-0110-0</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3389/fimmu.2019.01731</oboInOwl:hasDbXref>
    </owl:Axiom>
