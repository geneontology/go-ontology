        <oboInOwl:hasExactSynonym>T helper cells type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>T(H)-2 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th2 T cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th2 T lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th2 T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th2 T-lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Th2 cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>helper T cell type 2</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:comment>This cell type is compatible with the HIPC Lyoplate markers for &apos;non-Th1/Th17 CD4+ T cell&apos; (see CL:0001051), but includes the additional necessary and sufficient conditions to allow classification as a T-helper 2 T cell.</rdfs:comment>
        <rdfs:label>T-helper 2 cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000546</rdfs:seeAlso>
    </owl:Class>
