        <oboInOwl:hasBroadSynonym>intraepithelial lymphocyte</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, gamma-delta intraepithelial T lymphocyte</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, gamma-delta intraepithelial T-cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CD8-positive, gamma-delta intraepithelial T-lymphocyte</oboInOwl:hasExactSynonym>
