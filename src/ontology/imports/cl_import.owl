        <oboInOwl:hasDbXref>DOI:10.1038/nri3738</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.1084/jem.20191130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>DOI:10.3389/fphys.2021.699152/full</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_1000334"/>
