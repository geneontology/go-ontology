    <!-- http://purl.obolibrary.org/obo/CL_0000158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0000158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000157"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002202"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0008055"/>
