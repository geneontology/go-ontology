        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>enterocyte of epithelium of small intestine</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1000334</rdfs:seeAlso>
        <foaf:depiction rdf:resource="http://purl.obolibrary.org/obo/cl/images/Small-intestine-cells.png"/>
    </owl:Class>
