        <rdfs:label>CD4-positive, CD25-positive, alpha-beta regulatory T cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000792</rdfs:seeAlso>
    </owl:Class>
