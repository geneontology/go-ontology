    <!-- http://purl.obolibrary.org/obo/CL_0002085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CL_0002085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0000065"/>
        <obo:IAO_0000115>A specialized elongated ventricular ependymal cell with one or more processes that extend into the brain parenchyma or associated blood vessels where they contact blood vessel endothelial cells and/or neurons. These cells are found in the ventricles and circumventricular organs of the brain. They are involved in hormonal regulation, gatekeeping molecules between the bloodstream and cerebrospinal fluid, metabolic sensing, and regulating food intake.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-1980-3228"/>
        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2010-07-15T11:21:11Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>BTO:0001953</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:54560</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>stretch cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>tanycyte-like cell</oboInOwl:hasNarrowSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:comment>This class includes cells that are sometimes referred to as tanycyte-like cells,  located in circumventricular organs (Langlet et al., 2023) as well as tanycytes located in the ventricles.</rdfs:comment>
        <rdfs:label>tanycyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A specialized elongated ventricular ependymal cell with one or more processes that extend into the brain parenchyma or associated blood vessels where they contact blood vessel endothelial cells and/or neurons. These cells are found in the ventricles and circumventricular organs of the brain. They are involved in hormonal regulation, gatekeeping molecules between the bloodstream and cerebrospinal fluid, metabolic sensing, and regulating food intake.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:tfm</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:29351662</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>http://neurolex.org/wiki/Category:Tanycyte</oboInOwl:hasDbXref>
