    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0001031"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
        <owl:annotatedTarget>It has been noted in at least some mammalian species that granule cells are the most numerous cell type in the cerebellum and in the brain, with at least 99% of all cerebellar neurons being granule cells.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>doi:10.3389/fncir.2020.611841</oboInOwl:hasDbXref>
    </owl:Axiom>
