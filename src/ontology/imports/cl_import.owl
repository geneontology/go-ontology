        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0011026"/>
        <obo:IAO_0000115>A luminal epithelial cell of the mammary gland that can proliferate and has the potential to differentiate into a lactocyte during pregnancy. In humans, a luminal adaptive secretory precursor cell can be identified by high levels of the markers EpCAM and CD49f, and in mice it can be identified by low levels of CD29 and high levels of CD14, Kit, CD61, and Tspan8.</obo:IAO_0000115>
        <terms:contributor rdf:resource="https://orcid.org/0000-0001-6677-8489"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-4969-670X"/>
        <terms:date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-10-13T13:02:55Z</terms:date>
