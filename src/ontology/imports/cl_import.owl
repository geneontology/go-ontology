        <oboInOwl:hasDbXref>FBbt:00005412</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>FMA:18649</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009156</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>haploid nucleated cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>haploid germ cell</oboInOwl:hasRelatedSynonym>
        <rdfs:label>gamete</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000300</rdfs:seeAlso>
    </owl:Class>
