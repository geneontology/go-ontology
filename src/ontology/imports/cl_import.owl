        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0005006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0015004"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CLM_1000032"/>
            </owl:Restriction>
