        <oboInOwl:hasExactSynonym>myofiber</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>myofibril</oboInOwl:hasExactSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>myotube</rdfs:label>
