        <oboInOwl:hasDbXref>MESH:D003713</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ZFA:0009209</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>interdigitating cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veiled cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/uberon/core#human_reference_atlas"/>
        <rdfs:label>dendritic cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_0000451</rdfs:seeAlso>
    </owl:Class>
