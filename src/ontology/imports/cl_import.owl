        <oboInOwl:hasRelatedSynonym>cerebral cortex endothelial cells</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>endothelial cells of cerebral cortex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/cl#cellxgene_subset"/>
        <rdfs:label>cerebral cortex endothelial cell</rdfs:label>
        <rdfs:seeAlso>https://cellxgene.cziscience.com/cellguide/CL_1001602</rdfs:seeAlso>
    </owl:Class>
