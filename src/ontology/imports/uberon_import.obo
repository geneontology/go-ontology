property_value: UBPROP:0000001 "Anatomical cluster that is the upper roof of the mouth that is underlain by bones such as the parasphenoid, vomer, metapterygoid, orbitosphenoid.[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0002093", ontology="TAO", source="TAO:wd"}
