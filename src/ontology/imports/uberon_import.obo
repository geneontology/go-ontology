property_value: UBPROP:0000001 "The first of the two membranous sheets which partially separate the two atria during embryonic development. [TFD][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0000020", ontology="VHOG", source="http://bgee.unil.ch/", source="http://medical-dictionary.thefreedictionary.com/interatrial+septum+primum"}
