property_value: UBPROP:0000001 "An arterial trunk with origin from the right ventricle of the heart, and dividing into the right and left pulmonary arteries, which enter the corresponding lungs and branch with the bronchi. [TFD][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0001134", ontology="VHOG", source="http://bgee.unil.ch/", source="http://medical-dictionary.thefreedictionary.com/pulmonary+trunk"}
