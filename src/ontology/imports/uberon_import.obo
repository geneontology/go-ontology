property_value: foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/a7/Gray189.png" xsd:anyURI
property_value: UBPROP:0000001 "Dermal bone that forms part of the upper jaw, located antero-ventral to the premaxilla. The maxilla is a paired bone.[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000270", ontology="TAO", source="TAO:GA_TG"}
property_value: UBPROP:0000001 "Paired, intramembranous bone located on the lateral sides of the skull, posterior to the premaxillae.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000285", ontology="AAO", source="AAO:LAP"}
property_value: UBPROP:0000002 "relationship loss: overlaps autopalatine-maxillary joint (TAO:0001942)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000270", ontology="TAO"}
property_value: UBPROP:0000002 "relationship loss: overlaps premaxillary-maxillary joint (TAO:0002260)[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000270", ontology="TAO"}
property_value: UBPROP:0000005 "In some teleosts, the maxilla is located postero-ventral to the supramaxilla. Commonly, the articular process of the maxilla articulates with the autopalatine and ethmoidal region antero-medially. The maxilla is usually the largest bone in the upper jaw assemblage.[TAO]" xsd:string {date_retrieved="2012-09-06", external_class="TAO:0000270", ontology="TAO", source="Curator"}
property_value: UBPROP:0000007 "maxillary" xsd:string

