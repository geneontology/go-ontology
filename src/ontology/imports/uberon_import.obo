relationship: RO:0002202 UBERON:0007124 {gci_filler="NCBITaxon:10090", gci_relation="BFO:0000050", source="PMID:16313389"} ! pharyngeal pouch 3
relationship: RO:0002202 UBERON:0007125 {gci_filler="NCBITaxon:9606", gci_relation="BFO:0000050", notes="pouches 3 and 4 in human", source="PMID:16313389"} ! pharyngeal pouch 4
