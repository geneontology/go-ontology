xref: XAO:0004017
xref: ZFA:0005620
is_a: UBERON:0004765 {source="VSAO"} ! skeletal element
property_value: seeAlso "https://github.com/obophenotype/uberon/wiki/Modeling-endochondral-elements-Design-Pattern" xsd:anyURI

