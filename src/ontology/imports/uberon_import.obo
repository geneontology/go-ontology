property_value: UBPROP:0000001 "One of two nuclei comprising the interpositus cerebellar nuclear complex of the deep cerebellar nuclei." xsd:string {source="BIRNLEX:1158"}
property_value: UBPROP:0000001 "The globose nucleus is one of the deep cerebellar nuclei. It is located medial to the emboliform nucleus and lateral to the fastigial nucleus. This nucleus contains primarily large and small multipolar neurons. The globose nucleus and emboliform nucleus are occasionally referred to collectively as the interposed nucleus. [WP,unvetted][Wikipedia:Globose_nucleus]." xsd:string {source="Wikipedia:Globose_nucleus"}
property_value: UBPROP:0000008 "It is recognized in human cerebellum but is not distinguishable in all mammalian species" xsd:string {source="NIF"}
property_value: UBPROP:0000008 "it is recognized in human cerebellum but is not distinguishable in all mammalian species[MP]" xsd:string

