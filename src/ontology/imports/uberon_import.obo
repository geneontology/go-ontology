property_value: UBPROP:0000003 "Rhombomeric segmentation is found in all living vertebrates and is of fundamental importance to the development of the vertebrate head.[well established][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0000672", ontology="VHOG", source="DOI:10.1006/dbio.2002.0831 Mazet F, Shimeld SM, The Evolution of Chordate Neural Segmentation. Developmental Biology (2002)", source="http://bgee.unil.ch/"}
