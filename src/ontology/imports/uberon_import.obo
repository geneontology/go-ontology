property_value: UBPROP:0000001 "The outer cellular layer of the mammalian blastocyst. [Evolution, Fourth_Edition_(2006)_McGraw-Hill, Function, Vertebrates:_Comparative_Anatomy, p.750, see_Kardong_KV][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0000979", ontology="VHOG", source="http://bgee.unil.ch/"}
